{% extends "layouts/base.njk" %}

{% set categoryName = "" %}
{% for cat in categorias %}{% if cat.slug == category %}{% set categoryName = cat.nome %}{% endif %}{% endfor %}

{% block head %}
{% set jsonLdApp = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "url": site.url + page.url,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL"
  },
  "inLanguage": "pt-BR"
} %}
{% set jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": categoryName, "item": site.url + "/" },
    { "@type": "ListItem", "position": 3, "name": title, "item": site.url + page.url }
  ]
} %}
<script type="application/ld+json">{{ jsonLdApp | dump | safe }}</script>
<script type="application/ld+json">{{ jsonLdBreadcrumb | dump | safe }}</script>
{% endblock %}

{% block content %}
<article class="tool-page">
  <header class="tool-header">
    <p class="eyebrow">{{ categoryName }}</p>
    <h1>{{ title }}</h1>
    <p class="tool-lead">{{ description }}</p>
  </header>

  {% if site.adsenseEnabled %}
  <div class="ad-slot ad-slot-top">
    <p class="ad-label">Publicidade</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client="{{ site.adsenseClient }}" data-ad-slot="{{ site.adsenseSlot }}" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
  {% endif %}

  {{ content | safe }}

  {% if site.adsenseEnabled %}
  <div class="ad-slot ad-slot-bottom">
    <p class="ad-label">Publicidade</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client="{{ site.adsenseClient }}" data-ad-slot="{{ site.adsenseSlot }}" data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
  {% endif %}
</article>
{% endblock %}
