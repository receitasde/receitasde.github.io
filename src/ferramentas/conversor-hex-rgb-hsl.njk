<div class="widget">
  <div class="swatch" id="preview" style="height:100px;margin-bottom:20px"></div>

  <div class="field">
    <label for="hex-input">HEX</label>
    <input type="text" id="hex-input" value="#2f6fed">
  </div>

  <div class="field-row">
    <div class="field"><label for="r-input">R (0-255)</label><input type="number" id="r-input" min="0" max="255"></div>
    <div class="field"><label for="g-input">G (0-255)</label><input type="number" id="g-input" min="0" max="255"></div>
    <div class="field"><label for="b-input">B (0-255)</label><input type="number" id="b-input" min="0" max="255"></div>
  </div>

  <div class="field-row">
    <div class="field"><label for="h-input">H (0-360)</label><input type="number" id="h-input" min="0" max="360"></div>
    <div class="field"><label for="s-input">S (0-100%)</label><input type="number" id="s-input" min="0" max="100"></div>
    <div class="field"><label for="l-input">L (0-100%)</label><input type="number" id="l-input" min="0" max="100"></div>
  </div>

  <div class="result-line"><strong>CSS rgb()</strong><span id="css-rgb"></span></div>
  <div class="result-line"><strong>CSS hsl()</strong><span id="css-hsl"></span></div>
</div>

<script>
(function () {
  var hexInput = document.getElementById("hex-input");
  var r = document.getElementById("r-input"), g = document.getElementById("g-input"), b = document.getElementById("b-input");
  var h = document.getElementById("h-input"), s = document.getElementById("s-input"), l = document.getElementById("l-input");
  var preview = document.getElementById("preview");
  var cssRgb = document.getElementById("css-rgb"), cssHsl = document.getElementById("css-hsl");

  function rgbToHex(rv, gv, bv) {
    function toHex(v) { return Math.max(0, Math.min(255, Math.round(v))).toString(16).padStart(2, "0"); }
    return "#" + toHex(rv) + toHex(gv) + toHex(bv);
  }
  function hexToRgb(hex) {
    return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];
  }
  function rgbToHsl(rv, gv, bv) {
    rv /= 255; gv /= 255; bv /= 255;
    var max = Math.max(rv, gv, bv), min = Math.min(rv, gv, bv);
    var hh, ss, ll = (max + min) / 2;
    if (max === min) { hh = ss = 0; }
    else {
      var d = max - min;
      ss = ll > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case rv: hh = (gv - bv) / d + (gv < bv ? 6 : 0); break;
        case gv: hh = (bv - rv) / d + 2; break;
        case bv: hh = (rv - gv) / d + 4; break;
      }
      hh /= 6;
    }
    return [hh * 360, ss * 100, ll * 100];
  }
  function hslToRgb(hh, ss, ll) {
    hh = ((hh % 360) + 360) % 360; ss /= 100; ll /= 100;
    var c = (1 - Math.abs(2 * ll - 1)) * ss;
    var x = c * (1 - Math.abs((hh / 60) % 2 - 1));
    var m = ll - c / 2;
    var rr, gg, bb;
    if (hh < 60) { rr = c; gg = x; bb = 0; }
    else if (hh < 120) { rr = x; gg = c; bb = 0; }
    else if (hh < 180) { rr = 0; gg = c; bb = x; }
    else if (hh < 240) { rr = 0; gg = x; bb = c; }
    else if (hh < 300) { rr = x; gg = 0; bb = c; }
    else { rr = c; gg = 0; bb = x; }
    return [(rr + m) * 255, (gg + m) * 255, (bb + m) * 255];
  }

  function updateAllFrom(hex) {
    var rgb = hexToRgb(hex);
    var hsl = rgbToHsl(rgb[0], rgb[1], rgb[2]);
    hexInput.value = hex;
    r.value = Math.round(rgb[0]); g.value = Math.round(rgb[1]); b.value = Math.round(rgb[2]);
    h.value = Math.round(hsl[0]); s.value = Math.round(hsl[1]); l.value = Math.round(hsl[2]);
    preview.style.background = hex;
    cssRgb.textContent = "rgb(" + Math.round(rgb[0]) + ", " + Math.round(rgb[1]) + ", " + Math.round(rgb[2]) + ")";
    cssHsl.textContent = "hsl(" + Math.round(hsl[0]) + ", " + Math.round(hsl[1]) + "%, " + Math.round(hsl[2]) + "%)";
  }

  hexInput.addEventListener("input", function () {
    if (/^#[0-9a-fA-F]{6}$/.test(this.value.trim())) updateAllFrom(this.value.trim());
  });

  [r, g, b].forEach(function (el) {
    el.addEventListener("input", function () {
      var hex = rgbToHex(parseFloat(r.value) || 0, parseFloat(g.value) || 0, parseFloat(b.value) || 0);
      updateAllFrom(hex);
    });
  });

  [h, s, l].forEach(function (el) {
    el.addEventListener("input", function () {
      var rgb = hslToRgb(parseFloat(h.value) || 0, parseFloat(s.value) || 0, parseFloat(l.value) || 0);
      updateAllFrom(rgbToHex(rgb[0], rgb[1], rgb[2]));
    });
  });

  updateAllFrom("#2f6fed");
})();
</script>

<h2 id="como-usar">Como usar</h2>
<p>Altere qualquer um dos campos — HEX, RGB ou HSL — e os demais são recalculados automaticamente, junto com a pré-visualização da cor.</p>

<h2 id="quando-usar-cada-formato">Quando usar cada formato</h2>
<p><strong>HEX</strong> (<code>#rrggbb</code>) é o formato mais comum em CSS e design de interface, compacto e fácil de copiar. <strong>RGB</strong> representa a cor pela intensidade de vermelho, verde e azul (0 a 255 cada), útil quando se pensa em termos de mistura de luz. <strong>HSL</strong> (matiz, saturação, luminosidade) é mais intuitivo para ajustar uma cor de forma perceptual — por exemplo, aumentar a luminosidade sem mudar o tom, o que é mais difícil de fazer diretamente em RGB ou HEX.</p>

<h2 id="faq">Perguntas frequentes</h2>
<h3>Por que o valor HSL muda ligeiramente ao converter e voltar?</h3>
<p>Pequenas diferenças de arredondamento podem ocorrer porque HEX/RGB trabalham com números inteiros (0-255), enquanto a conversão para HSL envolve cálculos com casas decimais que são arredondados na exibição.</p>
<h3>Essa ferramenta suporta transparência (canal alfa)?</h3>
<p>Não nesta versão — ela trabalha apenas com cor sólida (HEX de 6 dígitos, RGB e HSL sem canal alfa).</p>
