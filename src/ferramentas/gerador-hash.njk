<div class="widget">
  <div class="field">
    <label for="input-text">Texto de entrada</label>
    <textarea id="input-text" style="min-height:140px" placeholder="Digite ou cole o texto..."></textarea>
  </div>

  <div class="result-line"><strong>MD5</strong><span></span></div>
  <div class="output-box" id="out-md5" style="margin-bottom:10px"></div>

  <div class="result-line"><strong>SHA-1</strong><span></span></div>
  <div class="output-box" id="out-sha1" style="margin-bottom:10px"></div>

  <div class="result-line"><strong>SHA-256</strong><span></span></div>
  <div class="output-box" id="out-sha256" style="margin-bottom:10px"></div>

  <div class="result-line"><strong>SHA-384</strong><span></span></div>
  <div class="output-box" id="out-sha384" style="margin-bottom:10px"></div>

  <div class="result-line"><strong>SHA-512</strong><span></span></div>
  <div class="output-box" id="out-sha512"></div>
</div>

<script>
(function () {
  function md5(str) {
    function rotl(x, c) { return ((x << c) | (x >>> (32 - c))) >>> 0; }

    var K = new Array(64);
    for (var i = 0; i < 64; i++) {
      K[i] = Math.floor(Math.abs(Math.sin(i + 1)) * 4294967296);
    }
    var S = [
      7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
      5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
      4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
      6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
    ];

    var bytes = Array.from(new TextEncoder().encode(str));
    var origLenBits = bytes.length * 8;

    bytes.push(0x80);
    while (bytes.length % 64 !== 56) bytes.push(0);
    for (var b = 0; b < 8; b++) {
      bytes.push(Math.floor(origLenBits / Math.pow(2, 8 * b)) & 0xff);
    }

    var a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;

    for (var chunkStart = 0; chunkStart < bytes.length; chunkStart += 64) {
      var M = new Array(16);
      for (var j = 0; j < 16; j++) {
        var o = chunkStart + j * 4;
        M[j] = (bytes[o] | (bytes[o + 1] << 8) | (bytes[o + 2] << 16) | (bytes[o + 3] << 24)) >>> 0;
      }

      var A = a0, Bv = b0, C = c0, D = d0;
      for (i = 0; i < 64; i++) {
        var F, g;
        if (i < 16) { F = (Bv & C) | (~Bv & D); g = i; }
        else if (i < 32) { F = (D & Bv) | (~D & C); g = (5 * i + 1) % 16; }
        else if (i < 48) { F = Bv ^ C ^ D; g = (3 * i + 5) % 16; }
        else { F = C ^ (Bv | (~D)); g = (7 * i) % 16; }

        F = (F + A + K[i] + M[g]) >>> 0;
        A = D;
        D = C;
        C = Bv;
        Bv = (Bv + rotl(F, S[i])) >>> 0;
      }

      a0 = (a0 + A) >>> 0;
      b0 = (b0 + Bv) >>> 0;
      c0 = (c0 + C) >>> 0;
      d0 = (d0 + D) >>> 0;
    }

    function toHexLE(n) {
      var out = "";
      for (var k = 0; k < 4; k++) {
        out += (((n >>> (8 * k)) & 0xff)).toString(16).padStart(2, "0");
      }
      return out;
    }

    return toHexLE(a0) + toHexLE(b0) + toHexLE(c0) + toHexLE(d0);
  }

  async function shaHex(algo, str) {
    var data = new TextEncoder().encode(str);
    var digest = await crypto.subtle.digest(algo, data);
    return Array.from(new Uint8Array(digest)).map(function (b) {
      return b.toString(16).padStart(2, "0");
    }).join("");
  }

  var input = document.getElementById("input-text");

  async function update() {
    var text = input.value;
    if (!text) {
      ["md5", "sha1", "sha256", "sha384", "sha512"].forEach(function (id) {
        document.getElementById("out-" + id).textContent = "";
      });
      return;
    }
    document.getElementById("out-md5").textContent = md5(text);
    document.getElementById("out-sha1").textContent = await shaHex("SHA-1", text);
    document.getElementById("out-sha256").textContent = await shaHex("SHA-256", text);
    document.getElementById("out-sha384").textContent = await shaHex("SHA-384", text);
    document.getElementById("out-sha512").textContent = await shaHex("SHA-512", text);
  }

  input.addEventListener("input", update);
  update();
})();
</script>

<h2 id="como-usar">Como usar</h2>
<ol>
  <li>Digite ou cole o texto na caixa acima.</li>
  <li>Os hashes MD5, SHA-1, SHA-256, SHA-384 e SHA-512 são calculados automaticamente.</li>
</ol>

<h2 id="o-que-e-hash">O que é uma função de hash</h2>
<p>Uma função de hash transforma qualquer quantidade de dados de entrada em uma sequência de tamanho fixo (o "hash" ou "resumo"). A mesma entrada sempre produz o mesmo hash, mas alterar até um único caractere da entrada muda completamente o resultado. Hashes são usados para verificar a integridade de arquivos, indexar dados e, em versões mais robustas, armazenar senhas de forma segura.</p>

<h2 id="qual-usar">Qual algoritmo usar</h2>
<p><strong>MD5</strong> e <strong>SHA-1</strong> são considerados criptograficamente fracos hoje — vulneráveis a ataques de colisão — mas ainda são amplamente usados para checagem de integridade de arquivos (verificar se um download não foi corrompido), não para segurança. Para qualquer uso relacionado a segurança (senhas, assinaturas, tokens), prefira <strong>SHA-256</strong> ou algoritmos superiores, idealmente combinados com técnicas específicas para senhas (como bcrypt ou Argon2), já que hashes genéricos como SHA-256 sozinhos não são ideais para armazenar senhas.</p>

<h2 id="faq">Perguntas frequentes</h2>
<h3>O texto que eu digito é enviado a algum servidor?</h3>
<p>Não. O MD5 é calculado com uma implementação em JavaScript local, e os demais algoritmos usam a Web Crypto API nativa do navegador — nenhum dado sai do seu dispositivo.</p>
<h3>Por que o mesmo texto sempre gera o mesmo hash?</h3>
<p>Isso é uma propriedade fundamental das funções de hash: determinismo. É o que permite comparar dois arquivos ou textos apenas comparando seus hashes, sem precisar comparar o conteúdo inteiro.</p>
